# Copie para .env na raiz antes de rodar `docker compose up --build`.
# Todos tem valor padrao no compose, entao rodar sem isto funciona;
# preencher e o que da uma execucao decente.

# Precisam ser DIFERENTES entre si: um assina a sessao, o outro assina
# o QR do ingresso. Iguais, vazar um daria poder sobre o outro.
JWT_SECRET=troque-por-algo-longo-e-aleatorio
TICKET_SIGNING_SECRET=troque-por-outro-valor-diferente
JWT_EXPIRES_IN=43200

# Sem chave, o provedor se declara indisponivel e a busca de catalogo
# volta vazia avisando qual faltou. A aplicacao continua funcionando.
TMDB_API_KEY=
TICKETMASTER_API_KEY=